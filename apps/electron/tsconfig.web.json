{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./node_modules/.tmp/web",
    "tsBuildInfoFile": "./node_modules/.tmp/web.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@md-viz/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src/renderer", "src/shared", "tests/renderer", "tests/setup.ts", "vitest.config.ts"]
}
